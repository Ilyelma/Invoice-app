rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Données principales de l'app ──────────────────────────
    // Tout utilisateur connecté peut lire et écrire
    match /zkm_data/{document} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Gestion des utilisateurs ──────────────────────────────
    // Lecture : tout utilisateur connecté (pour charger son propre rôle)
    // Écriture : bloquée côté client — uniquement via Firebase Functions (Admin SDK)
    match /zkm_users/{userId} {
      allow read:  if request.auth != null;
      allow write: if false; // Les Functions utilisent l'Admin SDK (bypass des règles)
    }
  }
}
